{
  "settings": [
    {
      ".name": "settings",
      ".type": "settings",
      "dns_type": "udp",
      "dns_server": ["8.8.8.8"]
    }
  ],
  "section": [
    {
      ".name": "GEMINI_TAILSCALE",
      ".type": "section",
      "label": "Gemini via Tailscale",
      "enabled": "1",
      "action": "tailscale",
      "condition_refs": ["cond_GEMINI_TAILSCALE"],
      "community_lists": ["google_ai"],
      "tailscale_control_url": "https://controlplane.tailscale.com",
      "tailscale_hostname": "tachyon-gemini-fixture",
      "tailscale_ephemeral": "0",
      "tailscale_accept_routes": "1",
      "tailscale_exit_node": "exit-node.example.test",
      "tailscale_exit_node_allow_lan_access": "1",
      "tailscale_auth_key": "tskey-auth-fixture-only-not-secret"
    }
  ],
  "condition": [
    {
      ".name": "cond_GEMINI_TAILSCALE",
      ".type": "condition",
      "enabled": "1",
      "condition_type": "atomic",
      "community_lists": ["google_ai"]
    }
  ]
}
