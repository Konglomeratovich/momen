config settings 'settings'
	option enabled '1'
	option dns_server '9.9.9.9'
	option bootstrap_dns_server '77.88.8.8'
	option download_lists_via_proxy '1'
	option download_subscriptions_via_proxy '1'
	option download_lists_via_proxy_section 'main'

config rule 'main'
	option enabled '1'
	option connection_type 'proxy'
	option proxy_config_type 'url'
	option proxy_string 'vless://b1234567-89ab-cdef-0123-456789abcdef@proxy.example:443?encryption=none&security=reality&sni=example.com&fp=chrome&pbk=NFnrxs1Ot_in47tmRnGdzYEQ7dXIcHihAHlsLyE0vpQ&type=tcp#Fixture'
	list domain 'Example.COM'
	list domain 'full:already.example'
	list rule_set 'https://fixture.invalid/domains.srs'
	list rule_set_with_subnets 'https://fixture.invalid/mixed.srs'

config section 'bypass_main'
	option enabled '1'
	option connection_type 'exclusion'
	list domain 'gosuslugi.ru'
	list ip_cidr '203.0.113.0/24'

config section 'vpn_interface'
	option enabled '1'
	option connection_type 'vpn'
	option proxy_config_type 'interface'
	option interface 'awg0'
	option domain_resolver_enabled '1'
	option domain_resolver_dns_type 'doh'
	option domain_resolver_dns_server 'https://dns.example/dns-query'

config section 'DIRECT'
	option enabled '1'
	option connection_type 'exclusion'
	option user_domain_list_type 'text'
	option user_domains_text 'example.ru plex.tv'
	list local_domain_lists '/etc/momen-r1-cyrillic-tlds.lst'
